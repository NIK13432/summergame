# --- Telegram ---
BOT_TOKEN=123456:ABC-your-token-from-BotFather
# Public HTTPS address of this server (Mini App opens here)
WEBAPP_URL=https://your-app.example.com
USE_WEBHOOK=1
WEBHOOK_SECRET=put-a-long-random-string-here
# Your Telegram user id (comma-separated for several) — enables /stats and /refund
ADMIN_IDS=123456789
SUPPORT_CONTACT=@your_support_username

# --- AI characters ---
ANTHROPIC_API_KEY=sk-ant-...
# claude-opus-5-5 = best quality; claude-haiku-5-5 = ~40x cheaper per message
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
# LLM_PROVIDER=mock   # free canned replies, for testing without a key

# --- Server ---
PORT=3000
# DB_PATH=/app/data/game.db
# CONTENT_DIR=/app/content
# DEV_MODE=1   # local browser testing without Telegram. NEVER in production.
